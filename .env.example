# PDFirst — Environment Configuration Template
# NOTE: All frontend variables must be prefixed with VITE_ to be exposed to the client.
# NEVER put private server API keys, database passwords, or secret tokens in this file or client code!

# Base API endpoint for the optional cloud synchronization service
VITE_SYNC_API_BASE_URL=https://api.pdfirst.com/v1

# Authentication Domain for optional multi-device account login (OAuth / Magic Link)
VITE_AUTH_DOMAIN=auth.pdfirst.com

# Public Client ID for authentication provider
VITE_AUTH_CLIENT_ID=pdfirst_web_client_prod

# Maximum allowable document size in megabytes before warning
VITE_MAX_DOCUMENT_SIZE_MB=10

# Environment Mode: development | staging | production
VITE_APP_ENV=development
